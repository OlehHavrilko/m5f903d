{
  "name": "car-to-atom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Car → Atom — interactive 3D teardown of a car, from the whole vehicle down to an iron atom. All geometry is procedural.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "eslint": "^9.39.5",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
